# ============================================================
# TEXTILE MARKETPLACE — SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values
# ============================================================

# ----- Server -----
NODE_ENV=development
PORT=5000

# ----- Database -----
MONGO_URI=mongodb://localhost:27017/textile_marketplace

# ----- Authentication -----
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ----- CORS -----
CLIENT_URL=http://localhost:5173

# ----- File Uploads -----
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=uploads/
