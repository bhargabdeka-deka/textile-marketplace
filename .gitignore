# ============================================================
# TEXTILE MARKETPLACE — ROOT .gitignore
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output
**/dist/
**/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Uploads (manage separately)
server/uploads/*
!server/uploads/.gitkeep

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
.nyc_output/
